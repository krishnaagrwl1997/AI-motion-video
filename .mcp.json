{
  "mcpServers": {
    "pollinations": {
      "command": "npx",
      "args": [
        "-y",
        "@pinkpixel/mcpollinations@1.3.1"
      ],
      "env": {
        "OUTPUT_DIR": "${MCP_OUTPUT_DIR:-public/generated}",
        "IMAGE_WIDTH": "1920",
        "IMAGE_HEIGHT": "1080",
        "POLLINATIONS_TOKEN": "${POLLINATIONS_TOKEN:-}"
      }
    },
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer ${HF_TOKEN}"
      }
    },
    "gemini": {
      "command": "uvx",
      "args": [
        "aio-gemini-mcp@0.5.0"
      ],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}",
        "GEMINI_OUTPUT_DIR": "${MCP_OUTPUT_DIR}"
      }
    },
    "elevenlabs": {
      "command": "uvx",
      "args": [
        "elevenlabs-mcp"
      ],
      "env": {
        "ELEVENLABS_API_KEY": "${ELEVENLABS_API_KEY}",
        "ELEVENLABS_MCP_BASE_PATH": "${MCP_OUTPUT_DIR:-public/generated}",
        "ELEVENLABS_MCP_OUTPUT_MODE": "files"
      }
    }
  }
}
