{
  "name": "Remotion Studio",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    // Claude Code CLI + VS Code extension (https://github.com/anthropics/devcontainer-features)
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Installs Chrome libraries, uv (for the MCP servers in .mcp.json) and npm packages.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Start Remotion Studio every time the Codespace opens.
  "postAttachCommand": "npm run dev -- --no-open",
  // Files generated by the MiniMax / ElevenLabs MCP servers land here, ready for staticFile("generated/...").
  "remoteEnv": {
    "MCP_OUTPUT_DIR": "${containerWorkspaceFolder}/public/generated"
  },
  // API keys come from Codespaces secrets (github.com/settings/codespaces). All are optional; GEMINI_API_KEY is the main one.
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Google Gemini API key (images, video, music, voice). Create one in Google AI Studio",
      "documentationUrl": "https://aistudio.google.com/apikey"
    },
    "MINIMAX_API_KEY": {
      "description": "MiniMax API key for image, video and voice generation",
      "documentationUrl": "https://www.minimax.io/platform/user-center/basic-information/interface-key"
    },
    "ELEVENLABS_API_KEY": {
      "description": "ElevenLabs API key for voice, sound effects and music",
      "documentationUrl": "https://elevenlabs.io/app/settings/api-keys"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Remotion Studio", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
