{
  "name": "Remotion Studio",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22-bookworm",
  "features": {
    // Claude Code CLI + VS Code extension (https://github.com/anthropics/devcontainer-features)
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  // Installs Chrome libraries, uv (for the MCP servers in .mcp.json) and npm packages.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Start Remotion Studio every time the Codespace opens.
  "postAttachCommand": "npm run dev -- --no-open",
  // Files generated by the AI MCP servers (.mcp.json) land here, ready for staticFile("generated/...").
  "remoteEnv": {
    "MCP_OUTPUT_DIR": "${containerWorkspaceFolder}/public/generated"
  },
  // API keys come from Codespaces secrets (github.com/settings/codespaces). All are optional and free; Pollinations needs no key.
  "secrets": {
    "HF_TOKEN": {
      "description": "Free Hugging Face token (read access) for image, video and music Spaces",
      "documentationUrl": "https://huggingface.co/settings/tokens"
    },
    "GEMINI_API_KEY": {
      "description": "Free Google AI Studio key: voiceovers (free tier). Images/video/music need billing",
      "documentationUrl": "https://aistudio.google.com/apikey"
    },
    "ELEVENLABS_API_KEY": {
      "description": "Free ElevenLabs key: voices and sound effects (10k credits/month)",
      "documentationUrl": "https://elevenlabs.io/app/settings/api-keys"
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Remotion Studio", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
